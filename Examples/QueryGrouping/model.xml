<?xml version="1.0" encoding="UTF-8"?>
<root name="school-directory-statistics"
      cfg_mask_china_mobile="false"
      data_service="sqlite"
      org="example"
      _module_key="root">
  <district _name="School District"
            _module="School Directory"
            _module_key="school_directory"
            name="River District"/>

  <school_type _name="School Type"
               _module="School Directory"
               _module_key="school_directory"
               district="district()"
               name="Primary"/>

  <school _name="School"
          _module="School Directory"
          _module_key="school_directory"
          school_type="school_type()?"
          name="string()"
          public_note="string()?"
          class_count="integer()"
          planned_class_count="integer()?"
          registry_number="long()"
          former_registry_number="long()?"
          annual_budget="number()"
          proposed_budget="number()?"
          occupancy_ratio="float()"
          forecast_occupancy_ratio="float()?"
          inspection_score="double()"
          previous_inspection_score="double()?"
          opened_on="date()"
          expected_reopening="date()?"
          school_day_starts="time()"
          extended_day_ends="time()?"
          census_at="dateTime()"
          next_review_at="dateTime()?"
          active="bool()"
          reviewed="bool()?"/>
</root>
